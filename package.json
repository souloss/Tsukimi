{
	"name": "tsukimi",
	"type": "module",
	"version": "10.2.0",
	"engines": {
		"node": ">=22.12.0",
		"pnpm": ">=10.33.0 <11"
	},
	"scripts": {
		"generate-icons": "node scripts/generate-svelte-icons.mjs",
		"sync-content": "node scripts/sync-content.js",
		"check-docs-render": "node scripts/check-docs-render.mjs",
		"init-content": "node scripts/init-content-repo.js",
		"predev": "node scripts/generate-svelte-icons.mjs && (node scripts/sync-content.js || true)",
		"prebuild": "node scripts/generate-svelte-icons.mjs && node scripts/generate-file-icons.mjs && node scripts/sync-content.js",
		"dev": "NODE_OPTIONS='--max-old-space-size=6144 --max-semi-space-size=2' astro dev",
		"dev:mem": "NODE_OPTIONS='--max-old-space-size=16384' astro dev",
		"start": "astro dev",
		"check": "astro check",
		"update-anime": "node scripts/update-anime.mjs",
		"update-bangumi": "node scripts/update-bangumi.mjs",
		"update-bilibili": "node scripts/update-bilibili.mjs",
		"update-feeds": "node scripts/update-feeds.mjs",
		"refresh-data": "pnpm update-feeds && pnpm update-anime",
		"build": "node scripts/run-with-mem.js astro build && node scripts/build-pagefind.mjs && node scripts/compress-fonts/index.js",
		"build:refresh-data": "pnpm refresh-data && pnpm build",
		"submit": "node scripts/indexnow-submit.js",
		"preview": "astro preview",
		"astro": "astro",
		"type-check": "tsc --noEmit",
		"new-post": "node scripts/new-post.js",
		"format": "biome format --write ./src",
		"lint": "biome check --write ./src",
		"preinstall": "npx only-allow pnpm",
		"compress-fonts": "node scripts/compress-fonts/index.js",
		"prepare": "simple-git-hooks"
	},
	"dependencies": {
		"@astrojs/markdown-remark": "^7.3.0",
		"@astrojs/mdx": "^8.0.0",
		"@astrojs/rss": "^4.0.19",
		"@astrojs/sitemap": "^3.7.4",
		"@astrojs/svelte": "^9.0.1",
		"@fancyapps/ui": "^6.1.14",
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@iconify/svelte": "^5.2.2",
		"@swup/astro": "^1.8.0",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"astro": "^7.3.1",
		"astro-icon": "^1.2.0",
		"bytefield-svg": "1.11.0",
		"dayjs": "^1.11.23",
		"hastscript": "^9.0.1",
		"katex": "^0.18.5",
		"l2d-widget": "^0.0.2",
		"marked": "^18.0.11",
		"oddmisc": "1.2.11",
		"overlayscrollbars": "^2.16.0",
		"qrcode": "^1.5.4",
		"reading-time": "^1.5.0",
		"rehype-autolink-headings": "^7.1.0",
		"rehype-components": "^0.3.0",
		"rehype-external-links": "^3.0.0",
		"rehype-katex": "^7.0.1",
		"rehype-slug": "^6.0.0",
		"remark-directive": "^4.0.0",
		"remark-directive-rehype": "^1.0.0",
		"remark-math": "^6.0.0",
		"remark-sectionize": "^2.1.0",
		"stylus": "^0.64.0",
		"svelte": "5.57.0",
		"tailwindcss": "^4.3.3",
		"unist-util-visit": "^5.1.0",
		"vega": "6.4.0",
		"vega-embed": "7.2.0",
		"vega-lite": "6.4.3",
		"wavedrom": "3.7.0"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.10",
		"@astrojs/ts-plugin": "^1.10.11",
		"@biomejs/biome": "^2.5.12",
		"@expressive-code/core": "^0.44.2",
		"@expressive-code/plugin-collapsible-sections": "^0.44.2",
		"@expressive-code/plugin-line-numbers": "^0.44.2",
		"@expressive-code/plugin-text-markers": "^0.44.2",
		"@iconify-json/devicon": "^1.2.62",
		"@iconify-json/eos-icons": "^1.2.4",
		"@iconify-json/fa7-brands": "^1.2.4",
		"@iconify-json/fa7-regular": "^1.2.3",
		"@iconify-json/fa7-solid": "^1.2.5",
		"@iconify-json/lucide": "^1.2.129",
		"@iconify-json/material-symbols": "^1.2.90",
		"@iconify-json/mdi": "^1.2.3",
		"@iconify-json/simple-icons": "^1.2.94",
		"@iconify-json/svg-spinners": "^1.2.4",
		"@iconify-json/vscode-icons": "^1.2.76",
		"@types/hast": "^3.0.5",
		"@types/markdown-it": "^14.2.0",
		"@types/mdast": "^4.0.4",
		"@types/qrcode": "^1.5.6",
		"@types/sanitize-html": "^2.16.1",
		"astro-expressive-code": "^0.44.2",
		"axios": "^1.20.0",
		"fast-xml-parser": "^5.11.1",
		"glob": "^13.0.6",
		"hast-util-from-html": "2.0.3",
		"https-proxy-agent": "^9.1.0",
		"json5": "2.2.3",
		"lint-staged": "^17.4.1",
		"markdown-it": "^15.0.1",
		"node-html-parser": "^9.0.3",
		"pagefind": "^1.5.2",
		"pako": "^3.0.1",
		"postcss-import": "^17.0.0",
		"postcss-nesting": "^14.0.1",
		"remark-parse": "^11.0.0",
		"sanitize-html": "^2.17.7",
		"satori": "^0.33.4",
		"sharp": "^0.35.4",
		"simple-git-hooks": "^2.14.0",
		"subset-font": "^2.7.0",
		"svgo": "4.1.0",
		"typescript": "^6.0.3",
		"unified": "^11.0.5"
	},
	"packageManager": "pnpm@10.33.0",
	"simple-git-hooks": {
		"pre-commit": "pnpm lint-staged",
		"pre-push": "pnpm astro check"
	},
	"lint-staged": {
		"*.{js,ts,mjs,svelte,astro,json}": [
			"biome check --write --no-errors-on-unmatched"
		]
	}
}
