{
	"version": 1,
	"entries": [
		{
			"id": "admonition",
			"syntax": "> [!NOTE]",
			"implementation": "src/plugins/rehype-component-admonition.mjs"
		},
		{
			"id": "github-card",
			"syntax": "::github{repo=\"owner/name\"}",
			"implementation": "src/plugins/rehype-component-github-card.mjs"
		},
		{
			"id": "mermaid",
			"syntax": "```mermaid",
			"implementation": "src/plugins/remark-mermaid.js",
			"runtime": { "selector": "[data-tsukimi-diagram]", "loader": "diagram" }
		},
		{
			"id": "plantuml",
			"syntax": "```plantuml",
			"implementation": "src/plugins/remark-plantuml.js",
			"runtime": {
				"selector": "[data-tsukimi-diagram='plantuml']",
				"loader": "diagram"
			}
		},
		{
			"id": "vega-lite",
			"syntax": "```vega-lite",
			"implementation": "src/plugins/remark-vega-lite.js",
			"runtime": {
				"selector": "[data-tsukimi-diagram='vega-lite']",
				"loader": "diagram"
			}
		},
		{
			"id": "markmap",
			"syntax": "```markmap",
			"implementation": "src/plugins/remark-markmap.js",
			"runtime": {
				"selector": "[data-tsukimi-diagram='markmap']",
				"loader": "diagram"
			}
		},
		{
			"id": "file-tree",
			"syntax": "```file-tree",
			"implementation": "src/plugins/rehype-file-tree.mjs"
		},
		{
			"id": "include",
			"syntax": ":::include",
			"implementation": "src/plugins/remark-include.mjs"
		},
		{
			"id": "directive-content",
			"syntax": ":::note",
			"implementation": "src/plugins/remark-content-directives.mjs"
		},
		{
			"id": "math",
			"syntax": "$$ x^2 $$",
			"implementation": "src/plugins/remark-math-conditional.mjs",
			"runtime": { "selector": ".katex", "loader": "katex" }
		},
		{
			"id": "fancybox",
			"syntax": "![image](image.png)",
			"implementation": "src/scripts/handlers/fancybox-handler.ts",
			"runtime": { "selector": "[data-fancybox]", "loader": "fancybox" }
		}
	]
}
