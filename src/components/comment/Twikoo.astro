---
import { commentConfig } from "@/config";
import "@/styles/twikoo.css";

interface Props {
	path: string;
}

const config = {
	...commentConfig.twikoo,
	el: "#tcomment",
	path: Astro.props.path,
};
---

<div id="twikoo-container" class="twikoo-container">
  {/* Twikoo Container */}
  <div id="tcomment" class="not-prose"></div>

  {/* Loading indicator */}
  <div id="twikoo-loading" class="flex items-center justify-center py-8">
    <div class="animate-spin h-8 w-8 border-2 border-primary border-t-transparent rounded-full"></div>
  </div>

  {/* Fallback for disabled JS */}
  <noscript>
    <div class="rounded-lg bg-muted/50 p-4 text-center text-muted-foreground">
      请启用 JavaScript 以查看评论功能。
    </div>
  </noscript>

  <script is:inline define:vars={{ config }}>
    (function () {
      const state = window.__tsukimiTwikoo || (window.__tsukimiTwikoo = {
        observer: null,
        observerTarget: null,
        initPromise: null,
        scriptPromise: null,
        pendingInitTimer: null,
        timeoutId: null,
        initializedPath: null,
        initializedElement: null,
        initToken: 0,
        listenersInstalled: false,
        swupHookInstalled: false,
      });
      state.config = config;

      const TWIKOO_CONTAINER_ID = "twikoo-container";
      const TWIKOO_SCRIPT_URL = "/assets/js/twikoo.all.min.js";
      const ROOT_MARGIN = "200px";
      const LOADING_TIMEOUT = 15000;

      function getCurrentPath() {
        const pathname = window.location.pathname;
        return pathname.endsWith("/") && pathname.length > 1
          ? pathname.slice(0, -1)
          : pathname;
      }

      function hideLoading() {
        const loading = document.getElementById("twikoo-loading");
        if (loading) loading.style.display = "none";
        if (state.timeoutId) {
          clearTimeout(state.timeoutId);
          state.timeoutId = null;
        }
      }

      function showError(message) {
        const loading = document.getElementById("twikoo-loading");
        if (loading) {
          loading.textContent = message;
          loading.style.display = "block";
        }
      }

      function disconnectObserver() {
        if (state.observer) state.observer.disconnect();
        state.observer = null;
        state.observerTarget = null;
      }

      function resetPage() {
        state.initToken += 1;
        disconnectObserver();
        if (state.pendingInitTimer) {
          clearTimeout(state.pendingInitTimer);
          state.pendingInitTimer = null;
        }
        if (state.timeoutId) {
          clearTimeout(state.timeoutId);
          state.timeoutId = null;
        }
        state.initPromise = null;
        state.initializedPath = null;
        state.initializedElement = null;
      }

      function markProviderStyles() {
        document.head.querySelectorAll("style").forEach(function (style) {
          if (style.dataset.tsukimiTwikooStyle === "true") return;
          const text = style.textContent || "";
          if (text.includes(".tk-") || text.includes(".el-") || text.includes(".OwO")) {
            style.dataset.tsukimiTwikooStyle = "true";
          }
        });
      }

      function loadTwikooScript() {
        if (window.twikoo) return Promise.resolve();
        if (state.scriptPromise) return state.scriptPromise;

        const existing = document.getElementById("twikoo-script-loaded");
        state.scriptPromise = new Promise(function (resolve, reject) {
          const script = existing || document.createElement("script");
          if (!existing) {
            script.id = "twikoo-script-loaded";
            script.src = TWIKOO_SCRIPT_URL;
            script.async = true;
            document.head.appendChild(script);
          }
          script.addEventListener("load", resolve, { once: true });
          script.addEventListener("error", reject, { once: true });
        }).then(function () {
          markProviderStyles();
        });
        return state.scriptPromise;
      }

      function initTwikoo() {
        const commentEl = document.getElementById("tcomment");
        if (!commentEl) return Promise.resolve();
        if (!state.config.envId) {
          showError("评论系统未配置 envId");
          return Promise.resolve();
        }

        const currentPath = getCurrentPath();
        if (
          state.initializedPath === currentPath &&
          state.initializedElement === commentEl
        ) {
          hideLoading();
          return Promise.resolve();
        }
        if (state.initPromise) return state.initPromise;

        const token = state.initToken;
        const initConfig = state.config;
        state.timeoutId = setTimeout(hideLoading, LOADING_TIMEOUT);
        const promise = (async function () {
          try {
            await loadTwikooScript();
            if (token !== state.initToken || !document.body.contains(commentEl)) return;
            if (!window.twikoo) throw new Error("Twikoo API unavailable");

            commentEl.replaceChildren();
            await window.twikoo.init({
              ...initConfig,
              el: "#tcomment",
              path: currentPath,
              region: initConfig.region || undefined,
              visitorCount: initConfig.visitorCount !== undefined
                ? initConfig.visitorCount
                : false,
            });
            markProviderStyles();
            if (token !== state.initToken || !document.body.contains(commentEl)) return;

            state.initializedPath = currentPath;
            state.initializedElement = commentEl;
            await new Promise(function (resolve) {
              requestAnimationFrame(function () {
                requestAnimationFrame(resolve);
              });
            });
            void commentEl.offsetHeight;
            hideLoading();
          } catch (error) {
            if (token === state.initToken) showError("评论加载失败，请刷新重试");
          } finally {
            if (state.timeoutId) {
              clearTimeout(state.timeoutId);
              state.timeoutId = null;
            }
          }
        })();
        state.initPromise = promise;
        promise.finally(function () {
          if (state.initPromise === promise) state.initPromise = null;
        });
        return promise;
      }

      function setupLazyLoad() {
        const container = document.getElementById(TWIKOO_CONTAINER_ID);
        if (!container) {
          disconnectObserver();
          return;
        }
        if (state.observerTarget === container) return;
        disconnectObserver();

        if (
          state.initializedPath === getCurrentPath() &&
          state.initializedElement === document.getElementById("tcomment")
        ) {
          hideLoading();
          return;
        }
        if (typeof IntersectionObserver !== "function") {
          initTwikoo();
          return;
        }

        state.observerTarget = container;
        state.observer = new IntersectionObserver(function (entries) {
          if (!entries[0]?.isIntersecting) return;
          disconnectObserver();
          initTwikoo();
        }, { rootMargin: ROOT_MARGIN });
        state.observer.observe(container);
      }

      function scheduleInit() {
        if (state.pendingInitTimer) clearTimeout(state.pendingInitTimer);
        state.pendingInitTimer = setTimeout(function () {
          state.pendingInitTimer = null;
          setupLazyLoad();
        }, 100);
      }

      function setupSwupHook() {
        if (state.swupHookInstalled) return;
        const register = function () {
          if (!window.swup?.hooks || state.swupHookInstalled) return;
          state.swupHook = function () {
            resetPage();
            scheduleInit();
          };
          window.swup.hooks.on("content:replace", state.swupHook);
          state.swupHookInstalled = true;
        };
        if (window.swup?.hooks) register();
        else document.addEventListener("swup:enable", register, { once: true });
      }

      if (!state.listenersInstalled) {
        document.addEventListener("astro:page-load", function () {
          setupSwupHook();
          scheduleInit();
        });
        document.addEventListener("astro:before-swap", resetPage);
        document.addEventListener("tsukimi:page:loaded", scheduleInit);
        window.addEventListener("beforeunload", resetPage);
        state.listenersInstalled = true;
      }

      setupSwupHook();
      setupLazyLoad();
    })();
  </script>

  <style>
    .twikoo-container {
      min-height: 200px;
    }
  </style>
</div>
