---
import { commentConfig } from "@/config";

interface Props {
	path: string;
}

const config = {
	...commentConfig.twikoo,
	el: "#tcomment",
	path: Astro.props.path,
};
---

<div id="twikoo-container" class="twikoo-container">
  {/* Twikoo Container */}
  <div id="tcomment" class="not-prose"></div>

  {/* Loading indicator */}
  <div id="twikoo-loading" class="flex items-center justify-center py-8">
    <div class="animate-spin h-8 w-8 border-2 border-primary border-t-transparent rounded-full"></div>
  </div>

  {/* Fallback for disabled JS */}
  <noscript>
    <div class="rounded-lg bg-muted/50 p-4 text-center text-muted-foreground">
      请启用 JavaScript 以查看评论功能。
    </div>
  </noscript>

  <script is:inline define:vars={{ config }}>
    (function () {
      const TWIKOO_CONTAINER_ID = "twikoo-container";
      const TWIKOO_SCRIPT_URL = "/assets/js/twikoo.all.min.js";
      const ROOT_MARGIN = "200px";
      const LOADING_TIMEOUT = 15000;

      let observer = null;
      let twikooLoaded = false;
      let timeoutId = null;
      let initialized = false;
      let initializedPath = null;

      // Guard against concurrent init calls
      let initInProgress = false;

      // Store Swup hook reference for proper cleanup
      let swupContentReplaceHandler = null;

      function hideLoading() {
        const loading = document.getElementById('twikoo-loading');
        if (loading) {
          loading.style.display = 'none';
        }
        if (timeoutId) {
          clearTimeout(timeoutId);
          timeoutId = null;
        }
      }

      function showError(message) {
        const loading = document.getElementById('twikoo-loading');
        if (loading) {
          loading.innerHTML = '<div class="text-center text-muted-foreground">' + message + '</div>';
        }
      }

      function getCurrentPath() {
        const pathname = window.location.pathname;
        return pathname.endsWith("/") && pathname.length > 1
          ? pathname.slice(0, -1)
          : pathname;
      }

      function createTwikooConfig() {
        return {
          el: "#tcomment",
          envId: config.envId,
          path: getCurrentPath(),
          region: config.region || undefined,
          visitorCount: config.visitorCount !== undefined ? config.visitorCount : false,
        };
      }

      async function loadTwikooScript() {
        if (twikooLoaded || document.getElementById("twikoo-script-loaded")) {
          return;
        }
        return new Promise(function (resolve, reject) {
          const script = document.createElement("script");
          script.id = "twikoo-script-loaded";
          script.src = TWIKOO_SCRIPT_URL;
          script.async = true;
          script.onload = function () {
            twikooLoaded = true;
            resolve();
          };
          script.onerror = function () {
            showError('评论组件加载失败，请检查网络');
            reject(new Error('Failed to load Twikoo script'));
          };
          document.head.appendChild(script);
        });
      }

      async function initTwikoo() {
        // Prevent concurrent init calls
        if (initInProgress) {
          return;
        }

        const commentEl = document.getElementById("tcomment");
        if (!commentEl) {
          return;
        }

        if (!config.envId) {
          showError('评论系统未配置 envId');
          return;
        }

        // Skip re-init if already initialized for the current path
        const currentPath = getCurrentPath();
        if (initialized && initializedPath === currentPath) {
          hideLoading();
          return;
        }

        initInProgress = true;

        // Set timeout to force hide loading
        timeoutId = setTimeout(function () {
          hideLoading();
        }, LOADING_TIMEOUT);

        try {
          await loadTwikooScript();

          if (typeof twikoo === "undefined") {
            showError('评论脚本加载失败，请刷新重试');
            return;
          }

          // Clear previous contents only when path changed (genuine re-init)
          if (initialized) {
            commentEl.innerHTML = "";
          }

          const dynamicConfig = createTwikooConfig();
          await twikoo.init(dynamicConfig);
          initialized = true;
          initializedPath = currentPath;

          // Wait for Twikoo's internal Vue components to finish rendering,
          // then force a synchronous layout reflow so our CSS overrides take effect.
          await new Promise(function (r) { requestAnimationFrame(function () { requestAnimationFrame(r); }); });
          void commentEl.offsetHeight;

          hideLoading();
        } catch (error) {
          showError('评论加载失败，请刷新重试');
        } finally {
          initInProgress = false;
        }
      }

      function cleanup() {
        if (observer) {
          observer.disconnect();
          observer = null;
        }
        // Properly remove the Swup hook using the stored reference
        if (window.swup && window.swup.hooks && swupContentReplaceHandler) {
          try {
            window.swup.hooks.off("content:replace", swupContentReplaceHandler);
          } catch (_e) {
            // ignore
          }
          swupContentReplaceHandler = null;
        }
        initialized = false;
        initializedPath = null;
      }

      function setupLazyLoad() {
        const container = document.getElementById(TWIKOO_CONTAINER_ID);
        if (!container) {
          return;
        }

        // Don't create a new observer if one already exists
        if (observer) {
          return;
        }

        // Skip if already initialized for current path
        const currentPath = getCurrentPath();
        if (initialized && initializedPath === currentPath) {
          hideLoading();
          return;
        }

        observer = new IntersectionObserver(
          function (entries) {
            if (entries[0].isIntersecting) {
              if (observer) {
                observer.disconnect();
                observer = null;
              }
              initTwikoo();
            }
          },
          { rootMargin: ROOT_MARGIN },
        );

        observer.observe(container);
      }

      function setupSwupHooks() {
        if (swupContentReplaceHandler) {
          return; // Already registered
        }

        var registerHook = function () {
          if (!window.swup || !window.swup.hooks) return;
          // Store the handler reference for proper cleanup later
          swupContentReplaceHandler = function () {
            // Reset state for new page
            initialized = false;
            initializedPath = null;
            if (observer) {
              observer.disconnect();
              observer = null;
            }
            // Use the config-driven delay from tsukimi:page:loaded instead
            // of a hardcoded 200ms, so we don't double-init
          };
          window.swup.hooks.on("content:replace", swupContentReplaceHandler);
        };

        if (window.swup && window.swup.hooks) {
          registerHook();
        } else {
          document.addEventListener("swup:enable", function () {
            registerHook();
          }, { once: true });
        }
      }

      // Use a single init entry point after page transitions
      // to prevent multiple concurrent triggers
      var pendingInitTimer = null;
      function scheduleInit() {
        if (pendingInitTimer) {
          clearTimeout(pendingInitTimer);
        }
        pendingInitTimer = setTimeout(function () {
          pendingInitTimer = null;
          setupLazyLoad();
        }, 100);
      }

      // Astro page lifecycle events
      document.addEventListener("astro:page-load", function () {
        setupSwupHooks();
        scheduleInit();
      });

      document.addEventListener("astro:before-swap", cleanup);

      document.addEventListener("tsukimi:page:loaded", function () {
        // This event fires after the config-driven delay (250ms),
        // which is the right time to init comments
        scheduleInit();
      });

      window.addEventListener("beforeunload", cleanup);

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", function () {
          setupLazyLoad();
          setupSwupHooks();
        });
      } else {
        setupLazyLoad();
        setupSwupHooks();
      }
    })();
  </script>

  <style>
    .twikoo-container {
      min-height: 200px;
    }
  </style>
</div>
