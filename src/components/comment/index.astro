---
import type { CollectionEntry } from "astro:content";

import { commentConfig } from "@/config";
import { removeFileExtension } from "@/utils/url-utils";

interface Props {
	post?: CollectionEntry<"posts">;
	path?: string;
}

const { post, path: customPath } = Astro.props as Props;

const path = post
	? `/posts/${removeFileExtension(post.id)}`
	: (customPath ?? "");
// const url = `${Astro.site?.href}${path}`;

let commentService = "";
if (commentConfig?.enable) {
	if (commentConfig.system) {
		commentService = commentConfig.system;
	} else if (commentConfig.twikoo) {
		commentService = "twikoo";
	}
}

let CommentService: typeof import("./Twikoo.astro").default | undefined;
if (commentService === "twikoo") {
	CommentService = (await import("./Twikoo.astro")).default;
} else if (commentService === "waline") {
	CommentService = (await import("./Waline.astro")).default;
} else if (commentService === "giscus") {
	CommentService = (await import("./Giscus.astro")).default;
}

const commentEnabled = post ? (post.data.comment ?? true) : true;
---

{
	commentConfig?.enable && commentEnabled && path && (
		<div class="card-base p-6 mb-4">
				{CommentService && <CommentService path={path} />}
			{commentService === "" && null}
		</div>
	)
}
