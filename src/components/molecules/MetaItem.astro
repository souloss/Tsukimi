---
import { Icon } from "astro-icon/components";

interface Props {
	icon: string;
	class?: string;
}

const { icon, class: className = "" } = Astro.props as Props;
---

<div class:list={["flex items-center", className]}>
	<div class="meta-icon">
		<Icon name={icon} class="text-xl" />
	</div>
	<slot />
</div>
