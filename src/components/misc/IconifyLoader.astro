---
// Compatibility loader for legacy <iconify-icon> elements.
export interface Props {
	preloadIcons?: string[];
	timeout?: number;
	retryCount?: number;
}

const { preloadIcons = [], timeout = 10000, retryCount = 3 } = Astro.props;
---

<script is:inline define:vars={{ preloadIcons, timeout, retryCount }}>
	(function () {
		"use strict";

		if (window.__iconifyLoaderInitialized) return;
		window.__iconifyLoaderInitialized = true;

		const scriptUrl =
			"https://code.iconify.design/iconify-icon/3-latest/iconify-icon.min.js";
		const callbacks = new Set();
		const preloadQueue = new Set();
		let loadPromise = null;
		let iconObserver = null;

		const isReady = () => Boolean(customElements.get("iconify-icon"));

		const loadOnce = () =>
			new Promise((resolve, reject) => {
				if (isReady()) {
					resolve();
					return;
				}

				let script = document.querySelector('script[src*="iconify-icon"]');
				if (!script) {
					script = document.createElement("script");
					script.src = scriptUrl;
					script.async = true;
					script.crossOrigin = "anonymous";
					document.head.appendChild(script);
				}

				const timer = window.setTimeout(() => {
					cleanup();
					script.remove();
					reject(new Error("Iconify load timeout"));
				}, timeout);
				const poll = window.setInterval(() => {
					if (isReady()) complete();
				}, 50);

				const cleanup = () => {
					window.clearTimeout(timer);
					window.clearInterval(poll);
					script.removeEventListener("error", fail);
				};
				const complete = () => {
					cleanup();
					resolve();
				};
				const fail = () => {
					cleanup();
					script.remove();
					reject(new Error("Iconify script error"));
				};

				script.addEventListener("error", fail, { once: true });
			});

		const loadWithRetry = async () => {
			for (let attempt = 1; attempt <= retryCount; attempt++) {
				try {
					await loadOnce();
					return;
				} catch (error) {
					if (attempt === retryCount) throw error;
					await new Promise((resolve) => window.setTimeout(resolve, 1000));
				}
			}
		};

		const renderPreloads = () => {
			for (const icon of preloadQueue) {
				const element = document.createElement("iconify-icon");
				element.setAttribute("icon", icon);
				element.hidden = true;
				document.body.appendChild(element);
				window.setTimeout(() => element.remove(), 3000);
			}
			preloadQueue.clear();
		};

		const loader = {
			isLoaded: isReady(),
			load() {
				if (loader.isLoaded) return Promise.resolve();
				if (!loadPromise) {
					loadPromise = loadWithRetry()
						.then(() => {
							loader.isLoaded = true;
							window.iconifyLoaded = true;
							renderPreloads();
							for (const callback of callbacks) callback();
							callbacks.clear();
						})
						.catch((error) => {
							loadPromise = null;
							throw error;
						});
				}
				return loadPromise;
			},
			addToPreloadQueue(icons) {
				for (const icon of Array.isArray(icons) ? icons : [icons]) {
					preloadQueue.add(icon);
				}
				if (loader.isLoaded) renderPreloads();
			},
			onLoad(callback) {
				if (loader.isLoaded) callback();
				else callbacks.add(callback);
			},
		};

		window.__iconifyLoader = loader;
		const requestIconify = () =>
			loader.load().catch((error) => {
				console.error("Failed to load Iconify:", error);
			});
		const loadWhenNeeded = () => {
			if (!document.querySelector("iconify-icon")) return false;
			iconObserver?.disconnect();
			requestIconify();
			return true;
		};

		window.loadIconify = requestIconify;
		window.preloadIcons = (icons) => {
			loader.addToPreloadQueue(icons);
			requestIconify();
		};
		window.onIconifyReady = (callback) => loader.onLoad(callback);

		if (preloadIcons.length > 0) {
			window.preloadIcons(preloadIcons);
		} else if (!loadWhenNeeded()) {
			iconObserver = new MutationObserver(loadWhenNeeded);
			iconObserver.observe(document.documentElement, {
				childList: true,
				subtree: true,
			});
		}

		document.addEventListener("visibilitychange", () => {
			if (!document.hidden && !loader.isLoaded) loadWhenNeeded();
		});
	})();
</script>

<noscript>
	<style>
		iconify-icon {
			display: none;
		}
		.icon-fallback {
			display: inline-block;
		}
	</style>
</noscript>
