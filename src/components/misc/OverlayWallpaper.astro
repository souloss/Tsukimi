---
import type { BackgroundWallpaperConfig } from "@/types/config";

interface Props {
	config: NonNullable<BackgroundWallpaperConfig["overlay"]>;
	defaultMode?: string;
	wallpaperSwitchable?: boolean;
}

const {
	config,
	defaultMode = "banner",
	wallpaperSwitchable = true,
} = Astro.props;

const toArray = (src: string | string[] | undefined): string[] =>
	Array.isArray(src) ? src : typeof src === "string" ? [src] : [];

const source = config.src;
const sourceObject =
	typeof source === "object" && source !== null && !Array.isArray(source)
		? source
		: undefined;
const sharedSources = sourceObject ? [] : toArray(source as string | string[]);
const desktopSources = sourceObject
	? toArray(sourceObject.desktop)
	: sharedSources;
const mobileSources = sourceObject
	? toArray(sourceObject.mobile)
	: sharedSources;
const desktopSrc = desktopSources[0] || mobileSources[0];
const mobileSrc = mobileSources[0] || desktopSources[0];

if (!desktopSrc && !mobileSrc) {
	return null;
}

const opacity = config.opacity ?? 0.9;
const blur = config.blur ?? 0;
const zIndex = config.zIndex ?? 10;
const legacyPositions: Record<string, string> = {
	"top-left": "left top",
	"top-right": "right top",
	"bottom-left": "left bottom",
	"bottom-right": "right bottom",
};
const configuredPosition = config.position ?? "center";
const position = legacyPositions[configuredPosition] ?? configuredPosition;
const active = defaultMode === "overlay";
---

<div
	data-overlay-wallpaper
	class="pointer-events-none fixed inset-0 h-screen w-screen overflow-hidden transition-[opacity,filter] duration-300"
	style={`display: ${active ? "block" : "none"}; z-index: ${zIndex}; opacity: var(--wallpaper-opacity, ${opacity}); filter: blur(var(--wallpaper-blur, ${blur}px));`}
>
	{wallpaperSwitchable && (
		<script is:inline define:vars={{ defaultMode }}>
			(function() {
				const mode = localStorage.getItem('wallpaperMode') || defaultMode;
				document.currentScript.parentElement.style.display =
					mode === 'overlay' ? 'block' : 'none';
			})();
		</script>
	)}
	<picture class="absolute inset-0 block h-full w-full">
		{desktopSrc && <source media="(min-width: 768px)" srcset={desktopSrc} />}
		<img
			src={mobileSrc || desktopSrc}
			alt=""
			class="h-full w-full object-cover"
			style={`object-position: ${position};`}
			loading={active ? "eager" : "lazy"}
			fetchpriority={active ? "high" : undefined}
			decoding="async"
		/>
	</picture>
</div>
