---
import { resolveTextureConfig } from "@/config/textureConfig";

const texture = resolveTextureConfig();
---

{texture.enable && (
	<div
		id="texture-canvas"
		aria-hidden="true"
		data-texture-enabled="true"
		data-texture-preset={texture.defaultPreset}
		data-texture-motion={texture.allowMotion ? "true" : "false"}
	/>
)}
