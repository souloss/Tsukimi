---
import { Icon as AstroIcon } from "astro-icon/components";
import type { IconProps } from "./types";

const {
	icon,
	class: className = "",
	style = "",
	size = "md",
	color,
} = Astro.props as IconProps;

const sizeClasses = {
	xs: "text-xs",
	sm: "text-sm",
	md: "text-base",
	lg: "text-lg",
	xl: "text-xl",
	"2xl": "text-2xl",
};

const sizeClass = sizeClasses[size] || sizeClasses.md;
const colorStyle = color ? `color: ${color};` : "";
const combinedStyle = `${colorStyle}${style}`;
const combinedClass = `${sizeClass} ${className}`.trim();
---

<span
	class={`inline-flex items-center justify-center ${combinedClass}`}
	style={combinedStyle}
>
	<AstroIcon name={icon} class="icon-content" aria-hidden="true" />
</span>

<style>
	.icon-content {
		display: inline-flex;
		align-items: center;
		justify-content: center;
	}
</style>
