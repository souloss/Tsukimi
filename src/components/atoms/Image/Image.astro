---
import { Image as AstroImage, Picture } from "astro:assets";
import path from "node:path";

import imageManifest from "@/generated/image-manifest.json";

interface Props {
	id?: string;
	src: string;
	class?: string;
	alt?: string;
	position?: string;
	basePath?: string;
	loading?: "eager" | "lazy";
	fetchpriority?: "high" | "low" | "auto";
	width?: number;
	height?: number;
	widths?: number[];
	sizes?: string;
	placeholder?: string;
	fit?: "cover" | "contain";
	aspectRatio?: string;
}

import { url } from "../../../utils/url-utils";

const {
	id,
	src,
	alt,
	position = "center",
	basePath = "/",
	loading = "lazy",
	fetchpriority,
	width,
	height,
	widths,
	sizes,
	placeholder,
	fit = "cover",
	aspectRatio,
} = Astro.props;
const className = Astro.props.class;

const isLocal = !(
	src.startsWith("/") ||
	src.startsWith("http") ||
	src.startsWith("https") ||
	src.startsWith("data:")
);
const isPublic = src.startsWith("/");

// TODO temporary workaround for images dynamic import
// https://github.com/withastro/astro/issues/3373
let img: ImageMetadata | undefined;
if (isLocal) {
	const files = import.meta.glob<ImageMetadata>(
		[
			"../../../assets/**/*.{avif,gif,jpeg,jpg,png,webp}",
			"../../../content/posts/**/*.{avif,gif,jpeg,jpg,png,webp}",
		],
		{
			import: "default",
		},
	);
	const normalizedPath = path
		.normalize(path.join("../../../", basePath, src))
		.replace(/\\/g, "/");
	const file = files[normalizedPath];
	if (!file) {
		console.error(
			`\n[ERROR] Image file not found: ${normalizedPath.replace("../../../", "src/")}`,
		);
	} else {
		img = await file();
	}
}

const imageClass = `w-full h-full object-${fit}`;
const imageStyle = `object-position: ${position}`;
const responsiveWidths = widths ?? [320, 640, 960, 1280];
const responsiveSizes = sizes ?? "100vw";
const canConvert = img && img.format !== "gif" && img.format !== "svg";
type ImageManifestEntry = {
	width: number;
	height: number;
	placeholder: string;
	src: string;
	variants: Record<"avif" | "webp", Array<{ src: string; width: number }>>;
};
const publicImage = isPublic
	? (imageManifest.images as Record<string, ImageManifestEntry>)[src]
	: undefined;
const imageDimensions = {
	width: width ?? publicImage?.width,
	height: height ?? publicImage?.height,
};
const placeholderColor =
	placeholder ??
	publicImage?.placeholder ??
	"color-mix(in srgb, var(--primary) 10%, var(--card-bg))";
const publicSrcSet = (format: "avif" | "webp") =>
	publicImage?.variants[format]
		.map((variant) => `${url(variant.src)} ${variant.width}w`)
		.join(", ");
const wrapperStyle = [
	`background: ${placeholderColor}`,
	aspectRatio ? `aspect-ratio: ${aspectRatio}` : undefined,
]
	.filter(Boolean)
	.join(";");

// 检查是否是 Bilibili 图片
const isBilibiliImage = !isLocal && src.includes("hdslb.com");
// 对于外部图片（特别是 Bilibili），需要设置 referrerpolicy 避免 403 错误
const referrerPolicy = !isLocal && isBilibiliImage ? "no-referrer" : undefined;
---

<div
	id={id}
	class:list={[className, "overflow-hidden relative"]}
	style={aspectRatio ? `aspect-ratio: ${aspectRatio}` : undefined}
>
	<div
		class="transition absolute inset-0 dark:bg-black/10 bg-opacity-50 pointer-events-none"
		style={wrapperStyle}
	>
	</div>
	{
		isLocal && img && canConvert ? (
			<Picture
				src={img}
				alt={alt || ""}
				class={imageClass}
				style={imageStyle}
				loading={loading}
				fetchpriority={fetchpriority}
				width={width}
				height={height}
				widths={responsiveWidths}
				sizes={responsiveSizes}
				formats={["avif", "webp"]}
				fallbackFormat={img.format === "png" ? "png" : "webp"}
			/>
		) : isLocal && img ? (
			<AstroImage
				src={img}
				alt={alt || ""}
				class={imageClass}
				style={imageStyle}
				loading={loading}
				fetchpriority={fetchpriority}
				width={width}
				height={height}
				widths={responsiveWidths}
				sizes={responsiveSizes}
			/>
		) : null
	}
	{
		isPublic && publicImage ? (
			<picture>
				<source type="image/avif" srcset={publicSrcSet("avif")} sizes={responsiveSizes} />
				<source type="image/webp" srcset={publicSrcSet("webp")} sizes={responsiveSizes} />
				<img
					src={url(publicImage.src)}
					srcset={publicSrcSet("webp")}
					sizes={responsiveSizes}
					alt={alt || ""}
					class={imageClass}
					style={imageStyle}
					width={imageDimensions.width}
					height={imageDimensions.height}
					loading={loading}
					decoding="async"
					referrerpolicy={referrerPolicy}
					crossorigin={isBilibiliImage ? "anonymous" : undefined}
					fetchpriority={fetchpriority}
				/>
			</picture>
		) : (
			<img
				src={isPublic ? url(src) : src}
				alt={alt || ""}
				class={imageClass}
				style={imageStyle}
				loading={loading}
				decoding="async"
				referrerpolicy={referrerPolicy}
				crossorigin={isBilibiliImage ? "anonymous" : undefined}
				fetchpriority={fetchpriority}
				width={width}
				height={height}
			/>
		)
	}
</div>
