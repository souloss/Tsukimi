---
/**
 * AnalyticsScripts.astro
 * 第三方分析脚本组件 - 延迟加载优化
 *
 * 包含:
 * - Google Tag Manager (GTM)
 * - Microsoft Clarity (可选，通过 thirdPartyAnalytics 配置控制)
 * - Umami Analytics (可选，通过 analytics.umamiAnalytics 配置控制)
 *
 * 使用 requestIdleCallback 延迟加载以优化性能
 */

interface Props {
	gtmId?: string;
	thirdPartyAnalytics?: {
		enable: boolean;
		clarityId?: string;
	};
	umamiAnalytics?: {
		websiteId?: string;
		scriptUrl?: string;
		trackOutboundLinks?: boolean;
		collectWebVitals?: boolean;
		relpays?: {
			enabled?: boolean;
			sampleRate?: number;
			maskLevel?: "moderate" | "strict";
			maxDuration?: number;
			blockSelector?: string;
		};
	};
}

const {
	gtmId = "",
	thirdPartyAnalytics = { enable: false, clarityId: "" },
	umamiAnalytics,
} = Astro.props;

const clarityEnable =
	thirdPartyAnalytics.enable && thirdPartyAnalytics.clarityId;
const umamiEnable = umamiAnalytics?.websiteId && umamiAnalytics.scriptUrl;
const hasAnalytics = Boolean(gtmId || clarityEnable || umamiEnable);
---

{hasAnalytics && (
	<script is:inline>
		window.__tsukimiAnalyticsLoaders = [];
	</script>
)}

{gtmId && (
	<script is:inline define:vars={{ gtmId }}>
		window.__tsukimiAnalyticsLoaders.push(function () {
			window.dataLayer = window.dataLayer || [];
			window.dataLayer.push({
				"gtm.start": Date.now(),
				event: "gtm.js",
			});
			const script = document.createElement("script");
			script.async = true;
			script.src = "https://www.googletagmanager.com/gtm.js?id=" + gtmId;
			document.head.appendChild(script);
		});
	</script>
)}

{clarityEnable && (
	<script
		is:inline
		define:vars={{ clarityId: thirdPartyAnalytics.clarityId }}
	>
		window.__tsukimiAnalyticsLoaders.push(function () {
			window.clarity = window.clarity || function () {
				(window.clarity.q = window.clarity.q || []).push(arguments);
			};
			const script = document.createElement("script");
			script.async = true;
			script.src = "https://www.clarity.ms/tag/" + clarityId;
			document.head.appendChild(script);
		});
	</script>
)}

{umamiEnable && (
	<script
		is:inline
		define:vars={{
			umamiWebsiteId: umamiAnalytics?.websiteId,
			umamiScriptUrl: umamiAnalytics?.scriptUrl,
			umamiTrackOutboundLinks: umamiAnalytics?.trackOutboundLinks ?? true,
			umamiCollectWebVitals: umamiAnalytics?.collectWebVitals ?? false,
			umamiRelpaysEnabled: umamiAnalytics?.relpays?.enabled ?? false,
			umamiRelpaysSampleRate: umamiAnalytics?.relpays?.sampleRate ?? 0.15,
			umamiRelpaysMaskLevel:
				umamiAnalytics?.relpays?.maskLevel ?? "moderate",
			umamiRelpaysMaxDuration:
				umamiAnalytics?.relpays?.maxDuration ?? 300000,
			umamiRelpaysBlockSelector:
				umamiAnalytics?.relpays?.blockSelector || "",
		}}
	>
		window.__tsukimiAnalyticsLoaders.push(function () {
			const script = document.createElement("script");
			script.defer = true;
			script.src = umamiScriptUrl;
			script.setAttribute("data-website-id", umamiWebsiteId);
			if (umamiTrackOutboundLinks) {
				script.setAttribute("data-track-outbound-links", "true");
			}
			if (umamiCollectWebVitals) {
				script.setAttribute("data-collect-web-vitals", "true");
			}
			if (umamiRelpaysEnabled) {
				script.setAttribute("data-relpays-enabled", "true");
				script.setAttribute("data-relpays-sample-rate", umamiRelpaysSampleRate);
				script.setAttribute("data-relpays-mask-level", umamiRelpaysMaskLevel);
				script.setAttribute("data-relpays-max-duration", umamiRelpaysMaxDuration);
				if (umamiRelpaysBlockSelector) {
					script.setAttribute(
						"data-relpays-block-selector",
						umamiRelpaysBlockSelector,
					);
				}
			}
			document.head.appendChild(script);
		});
	</script>
)}

{hasAnalytics && (
	<script is:inline>
		(function scheduleAnalytics() {
			if (window.analyticsLoaded || window.__tsukimiAnalyticsScheduled) return;
			window.__tsukimiAnalyticsScheduled = true;
			const events = ["scroll", "mousemove", "keydown", "touchstart", "click"];
			function loadAnalytics() {
				if (window.analyticsLoaded) return;
				window.analyticsLoaded = true;
				events.forEach(function (event) {
					window.removeEventListener(event, loadAnalytics);
				});
				window.__tsukimiAnalyticsLoaders.forEach(function (load) {
					load();
				});
				window.__tsukimiAnalyticsLoaders = [];
			}
			events.forEach(function (event) {
				window.addEventListener(event, loadAnalytics, {
					once: true,
					passive: true,
				});
			});
			setTimeout(loadAnalytics, 10000);
		})();
	</script>
)}
