---
import FloatingControls from "@components/control/FloatingControls.astro";
import DisplaySettings from "@components/features/settings/DisplaySettings.svelte";
import Banner from "@components/layout/Banner.astro";
import RightSideBar from "@components/layout/RightSideBar.astro";
import FullscreenWallpaper from "@components/misc/FullscreenWallpaper.astro";
import IconifyLoader from "@components/misc/IconifyLoader.astro";
import OverlayWallpaper from "@components/misc/OverlayWallpaper.astro";
import Footer from "@components/organisms/footer/Footer.astro";
import Navbar from "@components/organisms/navigation/Navbar.astro";
import SideBar from "@components/widgets/sidebar/SideBar.astro";
import type { MarkdownHeading } from "astro";
import { Icon } from "astro-icon/components";

import { backgroundWallpaperConfig, siteConfig } from "../config";
import {
	BANNER_HEIGHT,
	WALLPAPER_BANNER,
	WALLPAPER_FULLSCREEN,
	WALLPAPER_NONE,
	WALLPAPER_OVERLAY,
} from "../constants/constants";
import {
	calculateGridLayout,
	getBannerImages,
	getMainPanelTop,
	getTransparencyClass,
	shouldEnableTransparency,
} from "../utils/grid-layout-utils";
import { widgetManager } from "../utils/widget-manager";
import Layout from "./Layout.astro";
import GridScripts from "./partials/GridScripts.astro";

interface Props {
	title?: string;
	banner?: string;
	description?: string;
	lang?: string;
	setOGTypeArticle?: boolean;
	postSlug?: string;
	headings?: MarkdownHeading[];
	coverImage?: string;
	canonicalUrl?: string;
	pageOverlayTitle?: string;
	pageOverlayDate?: string;
	pageOverlayCategory?: string;
	pageOverlayWords?: string;
}

const defaultWallpaperMode =
	backgroundWallpaperConfig.mode?.defaultMode ?? WALLPAPER_BANNER;
const wallpaperSwitchable = backgroundWallpaperConfig.mode?.switchable ?? true;
const wallpaperCanBeUsed =
	wallpaperSwitchable || defaultWallpaperMode !== WALLPAPER_NONE;
const shouldRenderBanner =
	wallpaperCanBeUsed &&
	(defaultWallpaperMode === WALLPAPER_BANNER || wallpaperSwitchable);
const shouldRenderFullscreen =
	wallpaperCanBeUsed &&
	(defaultWallpaperMode === WALLPAPER_FULLSCREEN || wallpaperSwitchable);
const shouldRenderOverlay =
	wallpaperCanBeUsed &&
	(defaultWallpaperMode === WALLPAPER_OVERLAY || wallpaperSwitchable);

// Avoid fetching or serializing wallpaper assets when the repository has disabled them.
const bannerImages = shouldRenderBanner
	? await getBannerImages()
	: { desktop: "", mobile: "" };

const {
	title,
	banner,
	description,
	lang,
	setOGTypeArticle,
	postSlug,
	coverImage,
	headings = [],
	canonicalUrl,
	pageOverlayTitle,
	pageOverlayDate,
	pageOverlayCategory,
	pageOverlayWords,
} = Astro.props;
const hasBannerCredit =
	shouldRenderBanner && (siteConfig.banner.credit?.enable ?? false);
const hasBannerLink = !!siteConfig.banner.credit?.url;

// 检查是否为首页
const isHomePage = Astro.url.pathname === "/" || Astro.url.pathname === "";
// 手机端非首页不显示banner的CSS类
const mobileNonHomeBannerClass = !isHomePage ? "mobile-hide-banner" : "";

// 计算主内容区域位置
const finalMainPanelTop = getMainPanelTop(defaultWallpaperMode, BANNER_HEIGHT);

// 计算网格布局
const {
	gridCols,
	sidebarClass,
	rightSidebarClass,
	mainContentClass,
	sidebarPresence,
	mobileShowSidebar,
	tabletShowSidebar,
	desktopShowSidebar,
} = calculateGridLayout({
	siteConfig,
	widgetManager,
});

const { hasRightSidebarComponents, hasMobileDrawerComponents } =
	sidebarPresence;

// 半透明效果
const shouldEnable = shouldEnableTransparency(defaultWallpaperMode);
const transparentClass = getTransparencyClass(shouldEnable);

// 布局模式
const defaultPostListLayout = siteConfig.postListLayout?.defaultMode || "list";

// 导航栏固定配置
const stickyNavbar = siteConfig.navbar?.stickyNavbar ?? false;
---

<Layout
	title={title}
	banner={banner}
	description={description}
	lang={lang}
	setOGTypeArticle={setOGTypeArticle}
	postSlug={postSlug}
	coverImage={coverImage}
	canonicalUrl={canonicalUrl}
>
	<GridScripts
		navbarTransparentMode={siteConfig.banner?.navbar?.transparentMode ||
			backgroundWallpaperConfig.common?.navbar?.transparentMode || "none"}
		fullscreenNavbarTransparentMode={backgroundWallpaperConfig.fullscreen
			?.navbar?.transparentMode ||
			backgroundWallpaperConfig.common?.navbar?.transparentMode || "none"}
		defaultWallpaperMode={defaultWallpaperMode}
		wallpaperSwitchable={wallpaperSwitchable}
		defaultPostListLayout={siteConfig.postListLayout?.defaultMode || "list"}
		BANNER_HEIGHT={BANNER_HEIGHT}
		pageScaling={siteConfig.pageScaling}
	/>

	{shouldRenderFullscreen && backgroundWallpaperConfig.fullscreen && (
		<FullscreenWallpaper
			config={backgroundWallpaperConfig.fullscreen}
			defaultMode={defaultWallpaperMode}
			wallpaperSwitchable={wallpaperSwitchable}
		/>
	)}
	{shouldRenderOverlay && backgroundWallpaperConfig.overlay && (
		<OverlayWallpaper
			config={backgroundWallpaperConfig.overlay}
			defaultMode={defaultWallpaperMode}
			wallpaperSwitchable={wallpaperSwitchable}
		/>
	)}

	<!-- 全局图标加载器 -->
	<IconifyLoader />

	<!-- Navbar -->
	<slot slot="head" name="head" />
	<div
		id="top-row"
		class="z-50 pointer-events-none relative transition-all duration-700 max-w-(--page-width) mx-auto px-0 md:px-4"
	>
		<div
			id="navbar-wrapper"
			class="pointer-events-auto transition-all sticky top-0"
		>
			<Navbar />
		</div>
		<div class="pointer-events-auto">
			<DisplaySettings client:only="svelte" />
		</div>
	</div>

	{shouldRenderBanner && (
		<Banner
			bannerImages={bannerImages}
			mobileNonHomeBannerClass={mobileNonHomeBannerClass}
			showTextOverlay={isHomePage &&
				(siteConfig.banner.bannerHomeText?.enable ?? false)}
		/>
	)}

	<!-- 页面覆盖层数据源（供 JS 读取，不在首页显示） -->
	{pageOverlayTitle && (
		<div
			id="page-overlay-data"
			data-title={pageOverlayTitle}
			data-date={pageOverlayDate || ""}
			data-category={pageOverlayCategory || ""}
			data-words={pageOverlayWords || ""}
			class="hidden"
		>
		</div>
	)}

	<!-- Main content -->
	<div
		class={`absolute w-full z-30 pointer-events-none ${mobileNonHomeBannerClass ? "mobile-main-no-banner" : ""} ${defaultWallpaperMode === WALLPAPER_NONE ? "no-banner-layout" : ""} ${transparentClass}`}
		style={`top: ${finalMainPanelTop}`}
	>
		<!-- The pointer-events-none here prevent blocking the click event of the TOC -->
		<div class="relative max-w-(--page-width) mx-auto pointer-events-auto">
			<div
				id="main-grid"
				class={`transition duration-700 w-full left-0 right-0 grid ${gridCols} grid-rows-none md:grid-rows-[auto] mx-auto gap-4 px-2 md:px-4 ${!mobileShowSidebar || !hasMobileDrawerComponents ? "mobile-no-sidebar" : ""} ${hasRightSidebarComponents ? "mobile-both-sidebar" : ""}`}
				data-layout-mode={defaultPostListLayout}
			>
				<!-- Banner image credit -->
				{
					hasBannerCredit && (
						<a
							href={siteConfig.banner.credit?.url}
							id="banner-credit"
							target="_blank"
							rel="noopener"
							aria-label="Visit image source"
							class:list={[
								"group onload-animation transition-all absolute flex justify-center items-center rounded-full " +
									"px-3 right-4 -top-13 bg-black/60 hover:bg-black/70 h-9",
								{
									"hover:pr-9 active:bg-black/80":
										hasBannerLink,
								},
							]}
						>
							<Icon
								class="text-white/75 text-[1.25rem] mr-1"
								name="material-symbols:copyright-outline-rounded"
							/>
							<div class="text-white/75 text-xs">
								{siteConfig.banner.credit?.text}
							</div>
							<Icon
								class:list={[
									"transition absolute text-[oklch(0.75_0.14_var(--hue))] right-4 text-[0.75rem] opacity-0",
									{
										"group-hover:opacity-100":
											hasBannerLink,
									},
								]}
								name="fa7-solid:arrow-up-right-from-square"
							/>
						</a>
					)
				}

				{/* 侧边栏和主内容区域容器 */}
				<div class="contents">
					{
						(mobileShowSidebar ||
							tabletShowSidebar ||
							desktopShowSidebar) && (
							<SideBar
								class={`${sidebarClass} ${transparentClass}`}
								headings={headings}
							/>
						)
					}

					{
						hasRightSidebarComponents && (
							<div
								class={`right-sidebar-container ${rightSidebarClass} ${transparentClass}`}
							>
								<RightSideBar headings={headings} />
							</div>
						)
					}
				</div>

				<main
					id="swup-container"
					class={`${mainContentClass} transition-main`}
				>
					<div
						id="content-wrapper"
						class="onload-animation transition-leaving"
					>
						<!-- the overflow-hidden here prevent long text break the layout-->
						<!-- make id different from windows.swup global property -->
						<slot />
						<div
							class="footer col-span-full onload-animation hidden lg:block"
						>
							<Footer />
						</div>
					</div>
				</main>

				<div
					class="footer col-span-full onload-animation block lg:hidden"
				>
					<Footer />
				</div>
			</div>

			<FloatingControls headings={headings} />
		</div>
	</div>

	<style>
		.right-sidebar-container {
			align-self: start;
			display: contents;
		}

		.right-sidebar-container #right-sidebar {
			height: fit-content;
		}
	</style>


	<!-- Sticky Navbar 初始化脚本 -->
	<script is:inline data-swup-ignore-script define:vars={{stickyNavbar}}>
		(function initStickyNavbar() {
			// 检查是否有存储的设置
			let stickyEnabled;
			const stored = localStorage.getItem('stickyNavbar');
			if (stored !== null) {
				stickyEnabled = stored === 'true';
			} else {
				// 使用配置的默认值
				stickyEnabled = stickyNavbar;
			}

			// 应用设置到 data 属性
			document.documentElement.setAttribute('data-sticky-navbar', String(stickyEnabled));

			// 使用 body class 作为主要机制 - CSS !important 规则强制固定定位
			if (stickyEnabled) {
				document.body.classList.add('sticky-navbar');
			} else {
				document.body.classList.remove('sticky-navbar');
			}

			// 处理 navbar 阴影和 scrolled 状态
			const navbar = document.getElementById('navbar');
			const navbarWrapper = document.getElementById('navbar-wrapper');
			if (stickyEnabled) {
				if (navbar) {
					navbar.classList.add('navbar-sticky-shadow');
					navbar.classList.add('scrolled');
					navbar.classList.remove('navbar-hidden');
				}
				if (navbarWrapper) {
					navbarWrapper.classList.remove('navbar-hidden');
				}
			} else {
				if (navbar) {
					navbar.classList.remove('navbar-sticky-shadow');
				}
				// 重新初始化滚动检测
				if (typeof window.initSemifullScrollDetection === 'function') {
					window.initSemifullScrollDetection();
				}
			}
		})();
	</script>
</Layout>

<!--
  Banner 和网格布局样式已提取到 src/styles/banner.css
  该文件通过 src/styles/main.css 导入
-->
